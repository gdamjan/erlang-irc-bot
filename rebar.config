%%-*- mode: erlang -*-
{erl_opts, [debug_info]}.
{deps, []}.

{relx, [
    {release, {ircbot, semver},
         [ircbot, sasl]},
    {mode, dev}
]}.

{profiles, [
    {prod, [
        {relx, [{mode, prod}]}
    ]},
    {minimal, [
        {relx, [{mode, minimal}]}
    ]}
]}.

{shell, [{apps, []}, {script_file, "config/dev.escript"}]}.
{minimum_otp_vsn, "23.0"}.
