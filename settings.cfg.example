%%-*- mode: erlang -*-

{connection, [
    {name, {local, libera}},
    {nickname, "erlbot-test"},
    {server,   {"irc.libera.chat", 6667}},
    {channels, [
        "##ircbot-test"
    ]},
    {plugins, [
        {'ircbot_plugin_uptime', []},
        {'ircbot_plugin_autojoin', []},
        {'ircbot_plugin_ping', []},
        {'ircbot_plugin_help', ["https://github.com/gdamjan/erlang-irc-bot/"]}
    ]}
]}.
